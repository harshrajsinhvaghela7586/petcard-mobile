{
  "expo": {
    "name": "PetCard",
    "slug": "petcard-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "petcardmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.harshrajsinh7419.petcardmobile",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PetCard to use your camera to scan pet QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A00",
          "sounds": [
            "./assets/sounds/tone_chime.wav",
            "./assets/sounds/tone_bell.wav",
            "./assets/sounds/tone_pop.wav",
            "./assets/sounds/tone_marimba.wav",
            "./assets/sounds/tone_alert.wav"
          ]
        }
      ],
      "expo-sharing",
      "expo-asset",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8daee91e-9491-4847-a221-726dba3aae09"
      }
    },
    "owner": "harshrajsinh_vaghela"
  }
}
